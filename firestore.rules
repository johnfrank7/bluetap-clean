rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRequester() {
      return signedIn() && currentUser().role == 'requester' && currentUser().mustChangePassword != true;
    }

    function isManager() {
      return signedIn()
        && currentUser().role == 'manager'
        && currentUser().managerStatus == 'active'
        && currentUser().mustChangePassword != true
        && currentUser().branchId is string
        && (request.auth.token.manager == true || request.auth.token.role == 'manager')
        && get(/databases/$(database)/documents/branches/$(currentUser().branchId)).data.status == 'active';
    }

    function isDistributor() {
      return signedIn()
        && currentUser().role == 'distributor'
        && currentUser().mustChangePassword != true
        && (currentUser().distributorStatus == 'active' || currentUser().distributorStatus == 'approved'
          || currentUser().approvalStatus == 'active' || currentUser().approvalStatus == 'approved'
          || currentUser().status == 'active' || currentUser().status == 'approved')
        && currentUser().branchId is string
        && get(/databases/$(database)/documents/branches/$(currentUser().branchId)).data.status == 'active';
    }

    function isAdmin() {
      return signedIn() && currentUser().role == 'admin'
        && currentUser().mustChangePassword != true
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    function isManagerBranch(branchId) {
      return isManager() && branchId == currentUser().branchId;
    }

    // The registration backend is the sole writer for these protected records.
    match /registrationSessions/{document=**} { allow read, write: if false; }
    match /usernameReservations/{document=**} { allow read, write: if false; }
    match /emailOtpVerifications/{document=**} { allow read, write: if false; }
    match /registrationOtpVerifications/{document=**} { allow read, write: if false; }
    match /authRateLimits/{document=**} { allow read, write: if false; }
    match /faceServiceLocks/{document=**} { allow read, write: if false; }
    match /registrationLimits/{document=**} { allow read, write: if false; }
    match /systemConfig/{document=**} { allow read, write: if false; }
    match /adminAuditLogs/{document=**} { allow read, write: if false; }
    // Manager operational events are created and scoped by trusted Render Node
    // dispatch actions. Clients cannot forge, alter, or directly enumerate them.
    match /managerOperationalEvents/{eventId} { allow read, write: if false; }
    match /branches/{branchId} {
      allow get: if isManager() && branchId == currentUser().branchId;
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      // Fixes the missing-profile read failure without allowing user discovery.
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin()
        || (isManager() && resource.data.branchId == currentUser().branchId));
      allow list: if isAdmin() || (isManager() && resource.data.branchId == currentUser().branchId);
      allow create, delete: if false;
      // Profile screens may update ordinary contact/profile fields only. Roles,
      // approval, username ownership, completion, terms, and verification are
      // server-owned and cannot be elevated by a client update.
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'email', 'role', 'status', 'distributorStatus', 'approvalStatus', 'accountStatus',
          'rejectionReason', 'username', 'usernameNormalized', 'unique_id',
          'emailVerified', 'emailVerifiedAt', 'emailVerificationRequired',
          'emailOtpVerification', 'registrationCompleted', 'onboardingStatus', 'faceVerification',
          'registrationLimitKeys', 'registrationLimitReservation', 'admin', 'manager',
          'branchId', 'branchNameSnapshot', 'requestedBranchId', 'requestedBranchNameSnapshot',
          'managerStatus', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy',
          'mustChangePassword', 'passwordChangedAt',
          'termsAcceptance', 'createdAt', 'restoredAt'
        ]);
    }

    // Catalog mutations are server-only. The backend validates Administrator
    // identity and writes audit records before using the Admin SDK.
    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /requests/{requestId} {
      // Requester queries are scoped with requester_id == request.auth.uid.
      allow read: if isRequester() && resource.data.requester_id == request.auth.uid;
      allow read: if isManagerBranch(resource.data.branchId);
      // A target Branch Manager may inspect only an incoming, still-pending
      // transfer. The source branch remains the owner until acceptance.
      allow read: if isManagerBranch(resource.data.transferToBranchId)
        && resource.data.status == 'branch_transfer_pending';
      // Distributors receive exact fulfillment data only after a trusted
      // server assignment to their UID and current branch.
      allow read: if isDistributor()
        && resource.data.assignedDistributorUid == request.auth.uid
        && resource.data.branchId == currentUser().branchId;
      // Creation, cancellation, and outside-radius decisions are Render Node
      // operations. This keeps radius/distance snapshots and Manager scope
      // authoritative instead of accepting client-written decisions.
      allow create, update, delete: if false;
    }
  }
}
