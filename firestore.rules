rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRequester() {
      return signedIn() && currentUser().role == 'requester';
    }

    function isManager() {
      return signedIn()
        && currentUser().role == 'manager'
        && currentUser().managerStatus == 'active'
        && currentUser().branchId is string
        && (request.auth.token.manager == true || request.auth.token.role == 'manager')
        && get(/databases/$(database)/documents/branches/$(currentUser().branchId)).data.status == 'active';
    }

    function isAdmin() {
      return signedIn() && currentUser().role == 'admin'
        && currentUser().mustChangePassword != true
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    function isManagerBranch(branchId) {
      return isManager() && branchId == currentUser().branchId;
    }

    // The registration backend is the sole writer for these protected records.
    match /registrationSessions/{document=**} { allow read, write: if false; }
    match /usernameReservations/{document=**} { allow read, write: if false; }
    match /emailOtpVerifications/{document=**} { allow read, write: if false; }
    match /registrationOtpVerifications/{document=**} { allow read, write: if false; }
    match /authRateLimits/{document=**} { allow read, write: if false; }
    match /faceServiceLocks/{document=**} { allow read, write: if false; }
    match /registrationLimits/{document=**} { allow read, write: if false; }
    match /systemConfig/{document=**} { allow read, write: if false; }
    match /adminAuditLogs/{document=**} { allow read, write: if false; }
    match /branches/{branchId} {
      allow get: if isManager() && branchId == currentUser().branchId;
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      // Fixes the missing-profile read failure without allowing user discovery.
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin()
        || (isManager() && resource.data.branchId == currentUser().branchId));
      allow list: if isAdmin() || (isManager() && resource.data.branchId == currentUser().branchId);
      allow create, delete: if false;
      // Profile screens may update ordinary contact/profile fields only. Roles,
      // approval, username ownership, completion, terms, and verification are
      // server-owned and cannot be elevated by a client update.
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'email', 'role', 'status', 'approvalStatus', 'accountStatus',
          'rejectionReason', 'username', 'usernameNormalized', 'unique_id',
          'emailVerified', 'emailVerifiedAt', 'emailVerificationRequired',
          'emailOtpVerification', 'registrationCompleted', 'onboardingStatus', 'faceVerification',
          'registrationLimitKeys', 'registrationLimitReservation', 'admin', 'manager',
          'branchId', 'managerStatus', 'mustChangePassword', 'passwordChangedAt',
          'termsAcceptance', 'createdAt', 'restoredAt'
        ]);
      allow update: if isManager() && resource.data.role == 'distributor'
        && resource.data.branchId == currentUser().branchId
        && request.resource.data.branchId == currentUser().branchId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalStatus', 'status', 'accountStatus', 'rejectionReason', 'updatedAt'
        ]);
    }

    // The water catalog is visible to signed-in BlueTap users. Only a trusted,
    // Firebase-authenticated Manager identity can mutate it.
    match /products/{productId} {
      allow read: if signedIn() && (currentUser().role != 'manager'
        || isManagerBranch(resource.data.branchId));
      allow create: if isManagerBranch(request.resource.data.branchId);
      allow update: if isManagerBranch(resource.data.branchId)
        && request.resource.data.branchId == resource.data.branchId;
      allow delete: if isManagerBranch(resource.data.branchId);
    }

    match /requests/{requestId} {
      // Requester queries are scoped with requester_id == request.auth.uid.
      allow read: if isRequester() && resource.data.requester_id == request.auth.uid;
      allow read: if isManagerBranch(resource.data.branchId);
      allow update: if isManagerBranch(resource.data.branchId)
        && request.resource.data.branchId == resource.data.branchId;
      allow create: if isRequester()
        && request.resource.data.requester_id == request.auth.uid
        && request.resource.data.branchId is string
        && get(/databases/$(database)/documents/branches/$(request.resource.data.branchId)).data.status == 'active'
        && request.resource.data.status == 'Pending';
      allow update: if isRequester()
        && resource.data.requester_id == request.auth.uid
        && resource.data.status == 'Pending'
        && request.resource.data.status == 'Cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updated_at', 'canceled_at'
        ]);
      allow delete: if false;
    }
  }
}
