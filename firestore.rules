rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function legacyAccountStateBlocked() {
      return currentUser().get('status', '') in ['inactive', 'Inactive', 'disabled', 'Disabled', 'suspended', 'Suspended', 'terminated', 'Terminated']
        || currentUser().get('managerStatus', '') in ['inactive', 'disabled', 'suspended', 'terminated']
        || currentUser().get('distributorStatus', '') in ['inactive', 'disabled', 'suspended', 'terminated']
        || currentUser().get('approvalStatus', '') in ['inactive', 'disabled', 'suspended', 'terminated'];
    }

    // Canonical accountStatus is authoritative when present. Legacy profiles
    // without it remain compatible unless an existing field explicitly blocks
    // the account. Unknown explicit values fail closed.
    function hasActiveGlobalAccount() {
      return signedIn()
        && (currentUser().get('accountStatus', '') == 'active'
          || (currentUser().get('accountStatus', '') == '' && !legacyAccountStateBlocked()));
    }

    function isRequester() {
      return hasActiveGlobalAccount() && currentUser().role == 'requester' && currentUser().mustChangePassword != true;
    }

    function isManager() {
      return hasActiveGlobalAccount()
        && currentUser().role == 'manager'
        && currentUser().managerStatus == 'active'
        && currentUser().mustChangePassword != true
        && currentUser().branchId is string
        && (request.auth.token.manager == true || request.auth.token.role == 'manager')
        && get(/databases/$(database)/documents/branches/$(currentUser().branchId)).data.status == 'active';
    }

    function isDistributor() {
      return hasActiveGlobalAccount()
        && currentUser().role == 'distributor'
        && currentUser().mustChangePassword != true
        && (currentUser().distributorStatus == 'active' || currentUser().distributorStatus == 'approved'
          || currentUser().approvalStatus == 'active' || currentUser().approvalStatus == 'approved'
          || currentUser().status == 'active' || currentUser().status == 'approved')
        && currentUser().branchId is string
        && get(/databases/$(database)/documents/branches/$(currentUser().branchId)).data.status == 'active';
    }

    function isAdmin() {
      return hasActiveGlobalAccount() && currentUser().role == 'admin'
        && currentUser().mustChangePassword != true
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    function isManagerBranch(branchId) {
      return isManager() && branchId == currentUser().branchId;
    }

    function isConversationUserParticipant(conversation) {
      return conversation.participantUserUids is list
        && request.auth.uid in conversation.participantUserUids
        && conversation.get('participantUserAccess', {}).get(request.auth.uid, '') in ['active', 'read_only'];
    }

    function isConversationBranchParticipant(conversation) {
      return conversation.participantBranchIds is list
        && currentUser().branchId in conversation.participantBranchIds
        && conversation.get('participantBranchAccess', {}).get(currentUser().branchId, '') in ['active', 'read_only'];
    }

    function conversationAccessIsCurrent(conversation) {
      return (conversation.status == 'active'
          && (conversation.get('accessEndsAt', null) == null
            || (conversation.accessEndsAt is timestamp && conversation.accessEndsAt > request.time)))
        || (conversation.status == 'read_only'
          && conversation.get('accessEndsAt', null) is timestamp
          && conversation.accessEndsAt > request.time);
    }

    function canReadConversation(conversation) {
      return conversationAccessIsCurrent(conversation)
        && (((isRequester() || isDistributor()) && isConversationUserParticipant(conversation))
          || (isManager() && isConversationBranchParticipant(conversation)));
    }

    // The registration backend is the sole writer for these protected records.
    match /registrationSessions/{document=**} { allow read, write: if false; }
    match /usernameReservations/{document=**} { allow read, write: if false; }
    match /emailOtpVerifications/{document=**} { allow read, write: if false; }
    match /registrationOtpVerifications/{document=**} { allow read, write: if false; }
    match /authRateLimits/{document=**} { allow read, write: if false; }
    match /faceServiceLocks/{document=**} { allow read, write: if false; }
    match /registrationLimits/{document=**} { allow read, write: if false; }
    match /systemConfig/{document=**} { allow read, write: if false; }
    // Public signup reads only this server-maintained, sanitized step policy.
    // The authoritative security document and every client write stay blocked.
    match /publicConfig/registrationPolicy {
      allow get: if resource.data.keys().hasOnly([
        'faceVerificationRequired', 'emailOtpRequired', 'policyVersion', 'updatedAt'
      ])
        && resource.data.faceVerificationRequired is bool
        && resource.data.emailOtpRequired is bool
        && resource.data.policyVersion is int;
      allow list, create, update, delete: if false;
    }
    match /adminAuditLogs/{document=**} { allow read, write: if false; }
    match /chatReports/{document=**} { allow read, write: if false; }
    match /chatModerationActions/{document=**} { allow read, write: if false; }
    match /chatRestrictions/{document=**} { allow read, write: if false; }
    // Render Node exclusively owns conversation uniqueness, idempotency, and
    // persistent message-rate state.
    match /chatAuthorityRegistry/{document=**} { allow read, write: if false; }
    match /chatMutationIds/{document=**} { allow read, write: if false; }
    match /chatRateLimits/{document=**} { allow read, write: if false; }
    // Manager operational events are written by Render Node. Source Managers
    // may read only their branch's transfer outcomes.
    match /managerOperationalEvents/{eventId} {
      allow get, list: if isManagerBranch(resource.data.sourceBranchId);
      allow create, update, delete: if false;
    }
    match /requesterActiveOrders/{document=**} { allow read, write: if false; }
    match /branches/{branchId} {
      // Manager may read only their own assigned branch (Admin-written branchId).
      // Distributor may read only their own authoritative assigned branch.
      // Pending-approval fields never satisfy this check.
      // Branchless, pending, or unapproved Distributors are blocked by isDistributor().
      allow get: if
        (isManager() && branchId == currentUser().branchId) ||
        (isDistributor() && branchId == currentUser().branchId);
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      // Fixes the missing-profile read failure without allowing user discovery.
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin()
        || (isManager() && resource.data.branchId == currentUser().branchId)
        || (isManager() && resource.data.role == 'distributor'
          && resource.data.distributorStatus == 'pending'
          && resource.data.requestedBranchId == currentUser().branchId));
      allow list: if isAdmin() || (isManager() && resource.data.branchId == currentUser().branchId)
        || (isManager() && resource.data.role == 'distributor'
          && resource.data.distributorStatus == 'pending'
          && resource.data.requestedBranchId == currentUser().branchId);
      allow create, delete: if false;
      // Profile screens may update ordinary contact/profile fields only. Roles,
      // approval, username ownership, completion, terms, and verification are
      // server-owned and cannot be elevated by a client update.
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'email', 'role', 'status', 'distributorStatus', 'approvalStatus', 'accountStatus',
          'rejectionReason', 'username', 'usernameNormalized', 'unique_id',
          'emailVerified', 'emailVerifiedAt', 'emailVerificationRequired',
          'emailOtpVerification', 'registrationCompleted', 'onboardingStatus', 'faceVerification',
          'registrationLimitKeys', 'registrationLimitReservation', 'admin', 'manager',
          'branchId', 'branchNameSnapshot', 'requestedBranchId', 'requestedBranchNameSnapshot',
          'branchMembershipVersion',
          'managerStatus', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy',
          'mustChangePassword', 'passwordChangedAt',
          'termsAcceptance', 'createdAt', 'restoredAt'
        ]);
    }

    // Catalog mutations are server-only. The backend validates Administrator
    // identity and writes audit records before using the Admin SDK.
    match /products/{productId} {
      allow read: if hasActiveGlobalAccount();
      allow create, update, delete: if false;
    }

    match /chatConversations/{conversationId} {
      // Render creates membership and lifecycle metadata. Clients may query
      // only their UID or current authoritative Manager branch.
      allow get, list: if canReadConversation(resource.data);
      allow create, update, delete: if false;

      // Render transactionally maintains the parent lifecycle/access
      // projection. Message listeners may read only while that parent remains
      // readable to the caller's current logical principal. Every message
      // write remains server-only.
      match /messages/{messageId} {
        allow read: if canReadConversation(
          get(/databases/$(database)/documents/chatConversations/$(conversationId)).data
        );
        allow create, update, delete: if false;
      }
    }

    match /requests/{requestId} {
      // assignmentVersion is server-owned relationship authority metadata.
      // All request mutations remain backend-only, so clients cannot forge it.
      // Administrator read-only platform-wide oversight.
      allow read: if isAdmin();
      // Requester queries are scoped with requester_id == request.auth.uid.
      allow read: if isRequester() && resource.data.requester_id == request.auth.uid;
      allow read: if isManagerBranch(resource.data.branchId);
      // A target Branch Manager may inspect only an incoming, still-pending
      // transfer. The source branch remains the owner until acceptance.
      allow read: if isManagerBranch(resource.data.transferToBranchId)
        && resource.data.status == 'branch_transfer_pending';
      // Distributors receive exact fulfillment data only after a trusted
      // server assignment to their UID and current branch.
      allow read: if isDistributor()
        && resource.data.assignedDistributorUid == request.auth.uid
        && resource.data.branchId == currentUser().branchId;
      // Creation, cancellation, and outside-radius decisions are Render Node
      // operations. This keeps radius/distance snapshots and Manager scope
      // authoritative instead of accepting client-written decisions.
      allow create, update, delete: if false;
    }
  }
}
