# Application environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Public Node-backend origin shared by Expo web, Android, and iOS.
# In staging, must point to the staging backend URL (must NOT be bluetap-clean.onrender.com).
EXPO_PUBLIC_API_BASE_URL=

# Staging Firebase web configuration (required when EXPO_PUBLIC_APP_ENV=staging)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
