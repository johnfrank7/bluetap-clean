# Application environment: development | staging | production
APP_ENV=development
NODE_ENV=production
PORT=3000

# Allowed CORS origins (comma-separated). In staging, must list explicit staging URLs.
ALLOWED_ORIGINS=

# Firebase Admin configuration (must NOT be bluetap-8c98d in staging)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=

# Supabase Storage configuration (must use dedicated staging project/bucket in staging)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_AVATAR_BUCKET=

# Email OTP provider: vercel-relay | resend
EMAIL_PROVIDER=
# In staging, VERCEL_MAIL_RELAY_URL must NOT point to https://bluetap-beta.vercel.app
VERCEL_MAIL_RELAY_URL=
INTERNAL_MAIL_RELAY_SECRET=
EMAIL_OTP_HASH_SECRET=

# DeepFace API configuration (in staging, must NOT point to https://bluetap-face-api.onrender.com)
DEEPFACE_API_URL=
DEEPFACE_API_KEY=
