# BlueTap Staging Environment Template (Node Backend)
# Set APP_ENV to 'staging' to enforce staging isolation and guards.
APP_ENV=staging
NODE_ENV=production
PORT=3000

# Allowed CORS origins for staging (comma-separated; must NOT trust production origins)
# Example: https://bluetap-staging.vercel.app,http://localhost:19006
ALLOWED_ORIGINS=https://bluetap-staging.vercel.app

# Firebase Admin Configuration for staging (bluetap-staging)
# Dedicated staging service account credentials must be generated from Firebase Console -> Project Settings -> Service accounts.
# Never copy or reuse production credentials from bluetap-8c98d.
FIREBASE_PROJECT_ID=bluetap-staging
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Staging Web API Key (used by backend Google Identity Toolkit username login verification)
FIREBASE_WEB_API_KEY=AIzaSyBfuRta5kl-ryk1MNVurafmEJdw2EBv_Qg

# Supabase Storage configuration for staging
# Use a dedicated staging Supabase project or set SUPABASE_STORAGE_DRIVER=mock
SUPABASE_STORAGE_DRIVER=mock
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=
# SUPABASE_AVATAR_BUCKET=

# Staging Email OTP configuration
# In staging, VERCEL_MAIL_RELAY_URL must NOT point to https://bluetap-beta.vercel.app
EMAIL_PROVIDER=resend
# VERCEL_MAIL_RELAY_URL=
# INTERNAL_MAIL_RELAY_SECRET=
EMAIL_OTP_HASH_SECRET=

# Staging DeepFace API (must NOT point to https://bluetap-face-api.onrender.com)
# DEEPFACE_API_URL=
# DEEPFACE_API_KEY=
